# Copy this file to .env for local use. On Vercel add the same names in Settings > Environment Variables.
# Never commit the real .env file.

# MySQL connection string from your database provider.
# Add ?connection_limit=1 for Vercel. If your provider needs SSL, also add &sslaccept=strict
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?connection_limit=1"

# Long random text (32+ characters). Used to hash OTPs and sessions.
AUTH_SECRET="replace-with-a-long-random-string"

# The email that becomes the main admin after it logs in with an email OTP.
ADMIN_EMAIL="you@example.com"

# Email OTP delivery through Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="PAUDIVA <login@yourdomain.com>"

# TESTING ONLY: returns the OTP in the API response so you can log in before email is set up.
# Anyone could log in as anyone while this is "true". Remove it before real users arrive.
OTP_DEV_ECHO="false"
